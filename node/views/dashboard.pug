extends layout.pug

block head
    // embed.js defines <metabase-dashboard> and the other Metabase components.
    script(defer src=`${metabaseSiteUrl}/app/embed.js`)
    // The Metabase URL goes in an attribute, so Pug escapes it.
    script(data-instance-url=metabaseSiteUrl).
        window.metabaseConfig = {
            isGuest: true,
            instanceUrl: document.currentScript.dataset.instanceUrl,
        };

block content
    h1 Analytics for #{customer.name}

    p.
        You're signed in as #[strong= user.username], who belongs to #{customer.name}.
        The token for this embed locks the dashboard's Customer ID filter to #[strong= customer.id],
        so every chart shows only #{customer.name}'s rows. The Date filter is editable, so you can change it.

    // The server signs a fresh token for each page load.
    metabase-dashboard(token=token with-title="true")
